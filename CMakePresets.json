{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Waveshare ESP32-P4 + ESP32-C6 (SDIO) — development",
      "description": "ESP-IDF target esp32p4; ESP32-C6 radio coprocessor over SDIO via ESP-Hosted",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "IDF_TARGET": "esp32p4",
        "SDKCONFIG": "${sourceDir}/build/default/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults;${sourceDir}/sdkconfig.dev.defaults"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2,
                "configs": [
                  "board/esp32p4-ftdi.cfg"
                ],
                "args": []
              }
            }
          ]
        }
      }
    },
    {
      "name": "production",
      "displayName": "Waveshare ESP32-P4 + ESP32-C6 (SDIO) — production",
      "description": "ESP-IDF target esp32p4; ESP32-C6 radio coprocessor over SDIO via ESP-Hosted",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/production",
      "cacheVariables": {
        "IDF_TARGET": "esp32p4",
        "SDKCONFIG": "${sourceDir}/build/production/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults"
      }
    }
  ]
}
