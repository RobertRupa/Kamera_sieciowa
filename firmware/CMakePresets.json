{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (ESP32-P4 development)",
      "description": "ESP-IDF 6.1 ESP32-P4 development; fixed target without set-target/fullclean",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "IDF_TARGET": "esp32p4",
        "SDKCONFIG": "${sourceDir}/build/default/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "schemaVersion": 1,
          "settings": [
            {
              "type": "openOCD",
              "value": {
                "debugLevel": 2,
                "configs": [
                  "board/esp32p4-ftdi.cfg"
                ],
                "args": []
              }
            }
          ]
        }
      }
    },
    {
      "name": "production",
      "displayName": "Production (ESP32-P4)",
      "description": "Separate production sdkconfig and output; same ESP32-P4 target",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/production",
      "cacheVariables": {
        "IDF_TARGET": "esp32p4",
        "SDKCONFIG": "${sourceDir}/build/production/sdkconfig",
        "SDKCONFIG_DEFAULTS": "${sourceDir}/sdkconfig.defaults"
      }
    }
  ]
}
