{
  "cmake.sourceDirectory": "${workspaceFolder}",
  "files.associations": {
    "*.hpp": "cpp"
  },
  "idf.extensionActivationMode": "always",
  "idf.flashType": "UART",
  "idf.buildPath": "${workspaceFolder}/build/default",
  "idf.sdkconfigFilePath": "${workspaceFolder}/build/default/sdkconfig",
  "idf.sdkconfigDefaults": [
    "${workspaceFolder}/sdkconfig.defaults"
  ],
  "idf.saveBeforeBuild": true,
  "idf.preBuildTask": "python scripts/prepare_web_assets.py",
  "clangd.arguments": [
    "--background-index",
    "--query-driver=**",
    "--compile-commands-dir=${workspaceFolder}/build/default"
  ],
  "idf.openOcdConfigs": [
    "board/esp32p4-ftdi.cfg"
  ],
  "idf.customExtraVars": {
    "IDF_TARGET": "esp32p4"
  }
}
