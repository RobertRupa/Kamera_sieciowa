CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="firmware/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X640_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X1280_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1920X1080_30FPS=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_APP_DEV_MODE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_APP_DEV_DEFAULT_CREDENTIALS=n
# Development AP is only authorized through the default CMake preset:
# sdkconfig.dev.defaults. The production preset does not enable it.
CONFIG_APP_C6_STORAGE_AUDITED=y
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_CJSON_NESTING_LIMIT=4
CONFIG_CJSON_CIRCULAR_LIMIT=8
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
# UVC MJPEG on the dedicated ESP32-P4 USB 2.0 High-Speed OTG device controller.
# Use the OTG device-role jumper; do not connect two USB hosts.
CONFIG_APP_USB_UVC_ENABLE=y
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_FORMAT_MJPEG_CAM1=y
CONFIG_UVC_MODE_BULK_CAM1=y
CONFIG_UVC_SUPPORT_TWO_CAM=n
CONFIG_UVC_CAM1_MULTI_FRAMESIZE=y
CONFIG_FRAMESIZE_SVGA=y
CONFIG_UVC_CAM1_FRAMESIZE_WIDTH=800
CONFIG_UVC_CAM1_FRAMESIZE_HEIGT=800
CONFIG_UVC_CAM1_FRAMERATE=50
CONFIG_UVC_MULTI_FRAME_WIDTH_1=800
CONFIG_UVC_MULTI_FRAME_HEIGHT_1=640
CONFIG_UVC_MULTI_FRAME_FPS_1=50
CONFIG_UVC_MULTI_FRAME_WIDTH_2=1280
CONFIG_UVC_MULTI_FRAME_HEIGHT_2=960
CONFIG_UVC_MULTI_FRAME_FPS_2=45
CONFIG_UVC_MULTI_FRAME_WIDTH_3=1920
CONFIG_UVC_MULTI_FRAME_HEIGHT_3=1080
CONFIG_UVC_MULTI_FRAME_FPS_3=30
CONFIG_TUSB_MANUFACTURER="Camera Hub"
CONFIG_TUSB_PRODUCT="ESP32-P4 OV5647 UVC"

CONFIG_IDF_TARGET="esp32p4"
